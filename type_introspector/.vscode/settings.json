{
    "python.testing.unittestEnabled": true,
    "python.testing.pytestEnabled": false,
    "python.testing.unittestArgs": [
        "-v",
        "-s",
        "./test",
        "-p",
        "test*.py"
    ],
    "python.testing.pytestArgs": [
        "tests"
    ],
    "pylint.args": [
        // pylint --disable=W0511 --disable=R0902 --disable=C0115 --disable=C0304 --disable=C0301 --disable=C0411 --disable=C0412 --disable=C0303 --disable=W0718 --disable=W0613 --disable=C0303 --disable=C0305 --disable=W0311 --disable=R0903 --disable=C0112 --disable=C0114 --disable=C0116
        "\"--disable=C0301\"",  // Line too long
        "\"--disable=C0411\"",  // 
        "\"--disable=C0412\"",  // 
        "\"--disable=C0303\"",  // Trailing whitespace
        "\"--disable=W0718\"",  // Catching too general exception
        "\"--disable=W0613\"",  // Unused argument
        "\"--disable=C0305\"",  // Trailing newlines
        "\"--disable=W0311\"",  // Bad indentation
        "\"--disable=R0903\"",  // Too few public methods
        "\"--disable=C0112\"",  // Empty function docstring
        "\"--disable=C0114\"",  // Missing module docstring
        "\"--disable=C0115\"",  // Missing class docstring
        "\"--disable=C0116\"",  // Missing function or method docstring
        "\"--disable=C0304\"",  // Final newline missing
        "\"--disable=R0902\"",  // Too many instance attributes
        "\"--disable=W0511\"",  // TODO
        "\"--disable=E0401\"",  // Unable to import
    ],
}